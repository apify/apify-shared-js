{
    "name": "@apify/pseudo_url",
    "version": "2.0.95",
    "description": "Tool to find the matching URLs on a page (or html document) by providing a URL pattern.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "keywords": [
        "apify"
    ],
    "author": {
        "name": "Apify",
        "email": "support@apify.com",
        "url": "https://apify.com"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apify/apify-shared-js"
    },
    "bugs": {
        "url": "https://github.com/apify/apify-shared-js/issues"
    },
    "homepage": "https://apify.com",
    "scripts": {
        "build": "pnpm clean && pnpm compile && pnpm copy",
        "clean": "rimraf ./dist",
        "compile": "tsup",
        "copy": "node ../../scripts/copy.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@apify/log": "workspace:^"
    },
    "engines": {
        "node": ">=22"
    }
}
